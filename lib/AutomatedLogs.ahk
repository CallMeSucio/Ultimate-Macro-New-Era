#Requires AutoHotkey v2.0

; Automated Logs are opt-in, event-level diagnostics, not a keyboard logger.
; Separate PowerShell worker uploads ONLY sanitized text after a run.
AutoLogsAllowed(settings) {
    return IniRead(settings, "AutomatedLogs", "Consent", "unset") = "yes"
        && IniRead(settings, "AutomatedLogs", "ConsentVersion", "unset") = "api-v2"
}

AutoLogsAskConsent(settings) {
    decision := IniRead(settings, "AutomatedLogs", "Consent", "unset")
    version := IniRead(settings, "AutomatedLogs", "ConsentVersion", "unset")
    if version = "api-v2" && decision = "yes"
        return true
    if version = "api-v2" && decision = "no"
        return false
    notice := "AUTOMATED LOGS - TESTER QA`n`nThis feature is RECOMMENDED for private testers but optional.`n`n"
    notice .= "If you agree, Ultimate Macro sends a text report to its secure upload server, which forwards it to the development team's private Discord after each run, recovery or manual stop.`n`n"
    notice .= "It may include: Windows/CPU/RAM basics, selected NON-PRIVATE macro settings, strategy name, macro-issued actions and positions, timings, outcomes, errors and verified rewards.`n`n"
    notice .= "It does NOT include passwords, account tokens, chat messages, screenshots, personal files or arbitrary typed keys.`n`n"
    notice .= "The Discord webhook stays on the development team's server. A tester-specific upload credential only permits sending diagnostic reports and can be revoked.`n`n"
    notice .= "You can disable sharing at any time in Settings.tds: [AutomatedLogs] Consent=no.`n`n"
    notice .= "Do you agree to send Automated Logs?"
    response := MsgBox(notice, "Ultimate Macro - Automated Logs Consent", "YesNo Icon? Default1")
    IniWrite(response = "Yes" ? "yes" : "no", settings, "AutomatedLogs", "Consent")
    IniWrite("api-v2", settings, "AutomatedLogs", "ConsentVersion")
    if response != "Yes"
        return false
    includeSteps := MsgBox("Share the entire recognized strategy ACTION LIST in reports?`n`n"
        "Reports already show actions UM actually attempts. This additional option includes planned steps that may not run.`n`n"
        "Choose No to keep full strategy contents private.", "Automated Logs - Strategy Sharing", "YesNo Icon? Default2")
    IniWrite(includeSteps = "Yes" ? "yes" : "no", settings, "AutomatedLogs", "IncludeStrategyActions")
    return true
}

AutoLogsNewId() {
    b := Buffer(16, 0)
    if DllCall("bcrypt\BCryptGenRandom", "Ptr", 0, "Ptr", b.Ptr, "UInt", 16, "UInt", 2, "UInt") != 0
        return ""
    text := ""
    Loop 16
        text .= Format("{:02x}", NumGet(b, A_Index - 1, "UChar"))
    return text
}

AutoLogsPath(id) {
    if !RegExMatch(id, "^[0-9a-f]{32}$")
        return ""
    return A_AppData "\Ultimate_Macro\AutomatedLogs\" id ".txt"
}

AutoLogsSafe(value) {
    text := String(value)
    text := StrReplace(StrReplace(StrReplace(text, "`r", " "), "`n", " "), "`t", " ")
    ; Values are generated by UM, never arbitrary user text. Drop special characters.
    return SubStr(RegExReplace(text, "[^A-Za-z0-9 _().,:=+\-/]", "?"), 1, 220)
}

AutoLogsSafeStep(step) {
    step := Trim(RegExReplace(String(step), "\s*;.*$", ""))
    ; Only known macro instructions with simple numeric/identifier arguments.
    if RegExMatch(step, "i)^(SpawnTower|UpgradeTower|SellTower|CloneTower|SetDJTrack|Sleep|Click|ChangeTargets|ToggleAutoskip|ActivateRaiseTheDead|BrawlerReposition|EnforcerReposition)\s*\([A-Za-z0-9_., +\-]{0,170}\)$")
        return AutoLogsSafe(step)
    return "other_or_redacted"
}

AutoLogsEvent(stateFile, kind, details := "") {
    id := IniRead(stateFile, "AutomatedLogs", "ActiveRunId", "")
    path := AutoLogsPath(id)
    if path = "" || !FileExist(path)
        return false
    kind := RegExReplace(kind, "[^a-z_]", "_")
    try {
        if FileGetSize(path) >= 135000
            return false
        line := FormatTime(, "yyyy-MM-dd HH:mm:ss") " | " kind " | " AutoLogsSafe(details) "`n"
        FileAppend(line, path, "UTF-8")
        return true
    } catch Error {
        return false
    }
}

AutoLogsBegin(settings, stateFile, version, strategyPath, strategySteps := "") {
    if !AutoLogsAskConsent(settings)
        return false
    id := AutoLogsNewId()
    path := AutoLogsPath(id)
    if path = ""
        return false
    try {
        DirCreate(A_AppData "\Ultimate_Macro\AutomatedLogs")
        FileAppend("ULTIMATE MACRO - AUTOMATED LOGS v1`nrun_id=" id "`nconsent=yes`n", path, "UTF-8")
        IniWrite(id, stateFile, "AutomatedLogs", "ActiveRunId")
    } catch Error {
        return false
    }
    AutoLogsEvent(stateFile, "start", "version=" version "; Windows=" A_OSVersion "; architecture=" (A_PtrSize = 8 ? "64bit" : "32bit"))
    cpu := RegExReplace(EnvGet("PROCESSOR_IDENTIFIER"), "[^A-Za-z0-9 _().,\-]", " ")
    AutoLogsEvent(stateFile, "cpu", cpu)
    memory := Buffer(64, 0)
    NumPut("UInt", 64, memory, 0)
    if DllCall("Kernel32\GlobalMemoryStatusEx", "Ptr", memory.Ptr, "Int")
        AutoLogsEvent(stateFile, "ram", "gib=" Round(NumGet(memory, 8, "UInt64") / 1073741824, 1))
    AutoLogsEvent(stateFile, "display", "desktop=" A_ScreenWidth "x" A_ScreenHeight)
    SplitPath(strategyPath, &strategyName)
    ; Report only basename; never send user directories or absolute file paths.
    AutoLogsEvent(stateFile, "strategy", strategyName)
    for option in [["Options", "PotatoMode"], ["Options", "AutoSkip"],
        ["Options", "UseTimeScale"], ["Options", "UpgradeDelay"], ["Options", "MoveEnabled"],
        ["Options", "LegacyMode"], ["Options", "TimeScaleMode"]] {
        setting := IniRead(settings, option[1], option[2], "unset")
        if RegExMatch(setting, "i)^(?:[0-9.]{1,7}|yes|no|on|off|true|false|unset|normal|fast|slow|adaptive)$")
            AutoLogsEvent(stateFile, "setting", option[2] "=" setting)
    }
    if IniRead(settings, "AutomatedLogs", "IncludeStrategyActions", "no") = "yes" && IsObject(strategySteps) {
        shown := 0
        for step in strategySteps {
            clean := AutoLogsSafeStep(step)
            if clean = "other_or_redacted"
                continue
            AutoLogsEvent(stateFile, "planned_step", clean)
            shown++
            if shown >= 500
                break
        }
        AutoLogsEvent(stateFile, "strategy_excerpt", "shown=" shown)
    }
    return true
}

AutoLogsFinish(stateFile, settings, outcome) {
    if !AutoLogsAllowed(settings)
        return false
    id := IniRead(stateFile, "AutomatedLogs", "ActiveRunId", "")
    path := AutoLogsPath(id)
    if path = "" || !FileExist(path)
        return false
    ; Prevent duplicate finalization across watchdog/F2/restart codepaths.
    try IniDelete(stateFile, "AutomatedLogs", "ActiveRunId")
    try FileAppend("result=" AutoLogsSafe(outcome) "`nfinished_at=" FormatTime(, "yyyy-MM-dd HH:mm:ss") "`n", path, "UTF-8")
    catch Error {
        return false
    }
    worker := A_WorkingDir "\setup\AutomatedLogsUpload.ps1"
    if !FileExist(worker)
        return false
    try {
        credential := A_WorkingDir "\setup\AutomatedLogs-Access.ini"
        privateCredential := A_AppData "\Ultimate_Macro\Options\AutomatedLogs-Access.ini"
        if !FileExist(credential) && !FileExist(privateCredential) {
            FileAppend("awaiting_tester_access", A_AppData "\Ultimate_Macro\AutomatedLogs\" id ".status", "UTF-8")
            return false
        }
        Run('powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "' worker '" -RunId ' id, A_WorkingDir, "Hide")
        return true
    } catch Error {
        return false
    }
}
